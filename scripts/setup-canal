#!/usr/bin/env bash
# setup-canal — Part 2: creates a new instance (= new channel) from the template
#
# Runs once per channel. Copies this template to ~/projetos/<name>/, generates .env,
# patches service files, starts dashboard, pauses for OAuth, starts scheduler.
#
# For any prompt with [default] shown, ENTER accepts the default.
set -euo pipefail

TEMPLATE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
echo "==> setup-canal"
echo "    Template: $TEMPLATE_DIR"
echo ""

# ============= A. Identity =============
read -rp "Instance name (ex: yt-pub-lives7): " NOME
[ -z "$NOME" ] && { echo "ERROR: name is required"; exit 1; }
DEST="$HOME/projetos/$NOME"
[ -e "$DEST" ] && { echo "ERROR: $DEST already exists"; exit 1; }

# Instance number (used in service names)
if [[ "$NOME" =~ ([0-9]+)$ ]]; then
  N="${BASH_REMATCH[1]}"
else
  MAX=0
  for d in "$HOME"/projetos/yt-pub-lives*; do
    [ -d "$d" ] || continue
    n="${d##*lives}"
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > MAX )) && MAX=$n
  done
  SUG_N=$((MAX + 1))
  read -rp "Instance number (services) [$SUG_N]: " N
  N=${N:-$SUG_N}
fi

# Port — suggest next free port 8091..8099
SUG=""
for p in $(seq 8091 8099); do
  ss -ltn 2>/dev/null | grep -q ":$p " || { SUG=$p; break; }
done
[ -z "$SUG" ] && SUG=8091
read -rp "Dashboard port [$SUG]: " PORTA
PORTA=${PORTA:-$SUG}
ss -ltn 2>/dev/null | grep -q ":$PORTA " && {
  echo "ERROR: port $PORTA already in use"; exit 1; }

# ============= B. YouTube =============
read -rp "Source YOUTUBE_CHANNEL_ID [UC2QbQDyPKuHk93dwo5iq3Sw]: " ORIG
ORIG=${ORIG:-UC2QbQDyPKuHk93dwo5iq3Sw}
read -rp "Destination channel handle (optional, ex: @InemaTIA): " DEST_HANDLE

# ============= C. Google Cloud =============
echo ""
echo "    -- Google Cloud credentials (1 project per instance) --"
read -rp "CLIENT_ID: " CLIENT_ID
[ -z "$CLIENT_ID" ] && { echo "ERROR: CLIENT_ID is required"; exit 1; }
read -rp "CLIENT_SECRET: " CLIENT_SECRET
[ -z "$CLIENT_SECRET" ] && { echo "ERROR: CLIENT_SECRET is required"; exit 1; }
read -rp "API_KEY: " API_KEY
[ -z "$API_KEY" ] && { echo "ERROR: API_KEY is required"; exit 1; }
read -rp "GCP_PROJECT: " GCP_PROJECT
[ -z "$GCP_PROJECT" ] && { echo "ERROR: GCP_PROJECT is required"; exit 1; }

# ============= D. AI =============
echo ""
read -rp "PIRAMYD_API_KEY: " PIRAMYD_API_KEY
[ -z "$PIRAMYD_API_KEY" ] && { echo "ERROR: PIRAMYD_API_KEY is required"; exit 1; }

# ============= E. Dashboard password =============
echo ""
read -rp "Dashboard password [Inema2026\$\$\$]: " DASHBOARD_PASSWORD
[ -z "$DASHBOARD_PASSWORD" ] && DASHBOARD_PASSWORD='Inema2026$$$'

# ============= F. Validacao de credenciais =============
echo ""
echo "==> Validating credentials..."

# CLIENT_ID format
if [[ "$CLIENT_ID" != *.apps.googleusercontent.com ]]; then
  echo "  WARNING: CLIENT_ID does not end with .apps.googleusercontent.com"
  echo "           Expected format: <numbers>-<hash>.apps.googleusercontent.com"
  read -rp "  Continue anyway? [s/N]: " _PROCEED
  [[ "${_PROCEED:-n}" =~ ^[sSyY]$ ]] || { echo "Cancelled."; exit 1; }
fi

# CLIENT_SECRET format
if [[ "$CLIENT_SECRET" != GOCSPX-* ]]; then
  echo "  WARNING: CLIENT_SECRET does not start with GOCSPX-"
  read -rp "  Continue anyway? [s/N]: " _PROCEED
  [[ "${_PROCEED:-n}" =~ ^[sSyY]$ ]] || { echo "Cancelled."; exit 1; }
fi

# API_KEY live test (non-blocking on network failure)
# Validate ORIG format before interpolating into URL
if [[ ! "$ORIG" =~ ^UC[A-Za-z0-9_-]{22}$ ]]; then
  echo "  WARNING: ORIG channel ID format unexpected (expected ^UC[A-Za-z0-9_-]{22}$), skipping API_KEY test"
else
  echo -n "  Testing API_KEY against YouTube... "
  _API_TEST=$(curl -sf --max-time 10 \
    "https://www.googleapis.com/youtube/v3/channels?part=id&id=${ORIG}&key=${API_KEY}" \
    2>/dev/null || echo "__CURL_FAILED__")

  if [ "$_API_TEST" = "__CURL_FAILED__" ]; then
    echo "no network (skipping)"
  elif echo "$_API_TEST" | python3 -c "import sys,json,sys; sys.exit(0 if 'error' in json.load(sys.stdin) else 1)" 2>/dev/null; then
    _ERR_MSG=$(echo "$_API_TEST" | python3 -c \
      "import sys,json; d=json.load(sys.stdin); print(d.get('error',{}).get('message','unknown'))" \
      2>/dev/null || echo "unknown")
    echo "FAILED"
    echo "  ERROR: API_KEY rejected by YouTube: $_ERR_MSG"
    read -rp "  Continue anyway? [s/N]: " _PROCEED
    [[ "${_PROCEED:-n}" =~ ^[sSyY]$ ]] || { echo "Cancelled."; exit 1; }
  else
    echo "OK"
  fi
fi

# ============= G. Operation =============
read -rp "Add to template sync-instances? [y/N]: " SYNC

# ============= Summary + confirmation =============
echo ""
cat <<INFO
==> Summary:
    Instance:  $NOME (number: $N)
    Dest:      $DEST
    Port:      $PORTA
    Source:    $ORIG
    Channel:   ${DEST_HANDLE:-<not provided>}
    GCP:       $GCP_PROJECT
INFO
read -rp "Confirm? [Y/n]: " OK
[[ "${OK:-s}" =~ ^[sSyY]$ ]] || { echo "Cancelled."; exit 1; }

# ============= 1. Copy template =============
echo ""
echo "==> Copying template..."
cp -r "$TEMPLATE_DIR" "$DEST"

# Remove instance-specific/sensitive state
rm -rf "$DEST/data" "$DEST/lives" "$DEST/.git"
rm -f  "$DEST/config/.env" \
       "$DEST/config/credentials.enc" \
       "$DEST/config/.encryption_key"

# ============= 2. Generate config/.env =============
# NOTE: generated via heredoc, not via Write — follows CLAUDE.md rule
cat > "$DEST/config/.env" <<EOF
# SOURCE channel (where lives come from)
YOUTUBE_CHANNEL_ID=$ORIG

# DESTINATION channel — Google Cloud credentials (1 project per instance)
CLIENT_ID=$CLIENT_ID
CLIENT_SECRET=$CLIENT_SECRET
API_KEY=$API_KEY
GCP_PROJECT=$GCP_PROJECT

# AI
PIRAMYD_API_KEY=$PIRAMYD_API_KEY

# Identification
INSTANCE_NAME=$NOME

# Dashboard web access password
DASHBOARD_PASSWORD=$DASHBOARD_PASSWORD
EOF
chmod 600 "$DEST/config/.env"
echo "    config/.env created (chmod 600)"

# ============= 3. Patch service files =============
# Template services have placeholders __INSTANCE_DIR__, __INSTANCE_NAME__,
# __INSTANCE_NUM__ and __PORT__ — replaced with real values here.
DASH_SVC="$DEST/systemd/yt-dashboard.service"
SCHED_SVC="$DEST/systemd/yt-scheduler.service"

sed -i \
  -e "s|__INSTANCE_DIR__|$DEST|g" \
  -e "s|__INSTANCE_NAME__|$NOME|g" \
  -e "s|__INSTANCE_NUM__|$N|g" \
  -e "s|__PORT__|$PORTA|g" \
  "$DASH_SVC" "$SCHED_SVC"

# Remove User= if present (user services don't need it)
sed -i '/^User=/d' "$DASH_SVC" "$SCHED_SVC"

# ============= 4. Systemd user symlinks =============
SDIR="$HOME/.config/systemd/user"
mkdir -p "$SDIR"
ln -sf "$DASH_SVC"  "$SDIR/yt-dashboard${N}.service"
ln -sf "$SCHED_SVC" "$SDIR/yt-scheduler${N}.service"
systemctl --user daemon-reload

# Start dashboard first (scheduler depends on OAuth)
systemctl --user enable --now "yt-dashboard${N}"
echo "    yt-dashboard${N}: ativo em http://localhost:$PORTA"

# ============= 5. OAuth (interactive) =============
echo ""
echo "==> Authenticate the destination channel with Google."
echo "    In another terminal, run:"
echo ""
echo "    GWS_CONFIG_DIR=$DEST/config python3 $DEST/scripts/yt-auth"
echo ""
echo "    The script will open a link — authorize with the channel owner account."
read -rp "Press ENTER after completing OAuth (or Ctrl+C to abort)..."

if [ ! -f "$DEST/config/credentials.enc" ]; then
  echo ""
  echo "WARNING: $DEST/config/credentials.enc was not created."
  echo "         The scheduler will fail until OAuth is completed."
  echo "         You can run yt-auth later and start with:"
  echo "           systemctl --user start yt-scheduler${N}"
fi

# ============= 6. Start scheduler =============
systemctl --user enable --now "yt-scheduler${N}" || \
  echo "WARNING: scheduler failed to start — check OAuth."

# ============= 7. sync-instances (optional) =============
if [[ "$SYNC" =~ ^[sSyY]$ ]]; then
  SI="$TEMPLATE_DIR/scripts/sync-instances"
  if grep -q "\"$DEST\"" "$SI"; then
    echo "    $DEST already registered in sync-instances"
  else
    sed -i "/^TARGETS=(/a\\    \"$DEST\"" "$SI"
    echo "    Added to $SI"
  fi
fi

# ============= 8. Register in master-dashboard/instances.json =============
INSTANCES_JSON="$TEMPLATE_DIR/master-dashboard/instances.json"
python3 - "$INSTANCES_JSON" "$N" "$NOME" "$DEST" "$PORTA" <<'PY'
import json, os, sys
path, num, nome, dest, porta = sys.argv[1:]
num, porta = int(num), int(porta)
data = []
if os.path.exists(path):
    try:
        data = json.load(open(path))
    except Exception:
        data = []
data = [d for d in data if d.get('id') != num]
data.append({
    'id': num,
    'name': nome,
    'path': dest,
    'port': porta,
    'scheduler_svc': f'yt-scheduler{num}',
    'dashboard_svc': f'yt-dashboard{num}',
})
data.sort(key=lambda d: d['id'])
json.dump(data, open(path, 'w'), indent=2, ensure_ascii=False)
print(f'    {path} updated ({len(data)} instances)')
PY
# Reload master to pick up new JSON
systemctl --user restart yt-master-dashboard 2>/dev/null \
  && echo "    yt-master-dashboard reiniciado"

# ============= Done =============
echo ""
echo "==> Done."
echo "    Dashboard: http://localhost:$PORTA"
echo "    Master:    http://localhost:8090"
echo "    Logs:      journalctl --user -u yt-dashboard${N} -f"
echo "               journalctl --user -u yt-scheduler${N} -f"

#!/usr/bin/env bash
# yt-clip — Cuts YouTube lives by topic and publishes the clips
# Pipeline: YouTube API (transcript) → Claude (analysis) → FFmpeg (cutting) → yt-publish
#
# Usage:
#   yt-clip <video_id> [options]
#
# Examples:
#   yt-clip 5gnTiNoYUcQ                              # Generate manual prompt + cut
#   yt-clip 5gnTiNoYUcQ --ai claude-api              # Use automatic Claude API
#   yt-clip 5gnTiNoYUcQ --dry-run                    # Show topics only, no cutting
#   yt-clip 5gnTiNoYUcQ --publish                    # Cut and publish to YouTube
#   yt-clip 5gnTiNoYUcQ --publish --privacy unlisted

set -euo pipefail

export PATH="$HOME/.deno/bin:/usr/bin:$HOME/.npm-global/bin:$HOME/google-cloud-sdk/bin:$HOME/.local/bin:$PATH"

# --- Config ---
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${GWS_CONFIG_DIR:-${SCRIPT_DIR}/../config}/.env"
if [[ -f "$ENV_FILE" ]]; then
  set -a; source "$ENV_FILE"; set +a
fi

WORK_DIR="${LIVES_DIR:-${SCRIPT_DIR}/../lives}"
PRIVACY="unlisted"
DRY_RUN=false
PUBLISH=false
VIDEO_ID=""
AI_MODE="manual"   # manual | claude-api
MIN_DURATION=120    # Minimum 2 min per clip
MAX_DURATION=900    # Maximum 15 min per clip

# --- Parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)    DRY_RUN=true; shift ;;
    --publish)    PUBLISH=true; shift ;;
    --privacy)    PRIVACY="$2"; shift 2 ;;
    --ai)         AI_MODE="$2"; shift 2 ;;
    --work-dir)   WORK_DIR="$2"; shift 2 ;;
    --min-dur)    MIN_DURATION="$2"; shift 2 ;;
    --max-dur)    MAX_DURATION="$2"; shift 2 ;;
    --help|-h)
      head -12 "$0" | tail -10
      echo ""
      echo "Options:"
      echo "  --dry-run     Analyze only, do not cut or publish"
      echo "  --publish     Cut AND publish to YouTube"
      echo "  --privacy     public|unlisted|private (default: unlisted)"
      echo "  --ai          manual|claude-api (default: manual)"
      echo "                manual: generate prompt to paste into Claude (interactive session)"
      echo "                claude-api: use ANTHROPIC_API_KEY automatically"
      echo "  --work-dir    Working directory (default: ~/projetos/gws/lives)"
      echo "  --min-dur     Minimum clip duration in seconds (default: 120)"
      echo "  --max-dur     Maximum clip duration in seconds (default: 900)"
      exit 0
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      exit 1
      ;;
    *)
      VIDEO_ID="$1"; shift ;;
  esac
done

if [[ -z "$VIDEO_ID" ]]; then
  echo "Error: provide the video_id" >&2
  exit 1
fi

JOB_DIR="$WORK_DIR/$VIDEO_ID"
mkdir -p "$JOB_DIR"

# ============================================================
# STEP 1: Download YouTube transcript
# ============================================================
echo "==> [1/5] Downloading YouTube transcript..."

if [[ -f "$JOB_DIR/transcript_raw.json3" ]]; then
  echo "    Transcript already exists, skipping download"
else
  # Try with cookies first, fallback without cookies
  if ! yt-dlp --cookies-from-browser firefox --remote-components ejs:github \
    --write-auto-sub --sub-lang pt --skip-download --sub-format json3 \
    -o "$JOB_DIR/%(id)s" "https://www.youtube.com/watch?v=$VIDEO_ID" 2>/dev/null; then
    echo "    Failed with cookies, trying without cookies..."
    yt-dlp --remote-components ejs:github \
      --write-auto-sub --sub-lang pt --skip-download --sub-format json3 \
      -o "$JOB_DIR/%(id)s" "https://www.youtube.com/watch?v=$VIDEO_ID" 2>/dev/null || true
  fi

  # Rename to standard name
  mv "$JOB_DIR/${VIDEO_ID}.pt.json3" "$JOB_DIR/transcript_raw.json3" 2>/dev/null || true
fi

if [[ ! -f "$JOB_DIR/transcript_raw.json3" ]]; then
  echo "Error: could not download the transcript" >&2
  exit 1
fi

# ============================================================
# STEP 2: Process transcript into ~30s blocks
# ============================================================
echo "==> [2/5] Processing transcript..."

python3 << PYEOF
import json

with open('$JOB_DIR/transcript_raw.json3') as f:
    data = json.load(f)

events = data.get('events', [])
segments = []
for e in events:
    if 'segs' in e:
        text = ''.join(s.get('utf8', '') for s in e['segs']).strip()
        if text and text != '\n':
            start_ms = e.get('tStartMs', 0)
            dur_ms = e.get('dDurationMs', 0)
            segments.append({
                'start_ms': start_ms,
                'end_ms': start_ms + dur_ms,
                'text': text.replace('\n', ' ')
            })

# Consolidate into ~30s blocks
blocks = []
if segments:
    current = {'start_ms': segments[0]['start_ms'], 'text': ''}
    for s in segments:
        current['text'] += ' ' + s['text']
        current['end_ms'] = s['end_ms']
        if s['end_ms'] - current['start_ms'] > 30000:
            blocks.append(current)
            current = {'start_ms': s['end_ms'], 'text': ''}
    if current['text'].strip():
        blocks.append(current)

# Save condensed transcript
condensed = []
for b in blocks:
    start = f"{int(b['start_ms']/1000//60):02d}:{int(b['start_ms']/1000%60):02d}"
    end = f"{int(b['end_ms']/1000//60):02d}:{int(b['end_ms']/1000%60):02d}"
    condensed.append(f"[{start}-{end}] {b['text'].strip()}")

with open('$JOB_DIR/condensed.txt', 'w') as f:
    f.write('\n'.join(condensed))

duration_min = blocks[-1]['end_ms'] / 1000 / 60 if blocks else 0
print(f"    {len(segments)} segmentos → {len(blocks)} blocos ({duration_min:.0f} min)")
PYEOF

# ============================================================
# STEP 3: Topic analysis
# ============================================================
echo "==> [3/5] Analyzing topics (mode: $AI_MODE)..."

PROMPT_CONFIG_FILE="${GWS_CONFIG_DIR:-${SCRIPT_DIR}/../config}/prompt_cortes.txt"
if [[ -f "$PROMPT_CONFIG_FILE" ]] && [[ -s "$PROMPT_CONFIG_FILE" ]]; then
  PROMPT_TEMPLATE="$(cat "$PROMPT_CONFIG_FILE")"
else
  PROMPT_TEMPLATE="Analyze this YouTube live transcript and identify the MAIN TOPICS.

For each topic, return:
- start: start timestamp (MM:SS)
- end: end timestamp (MM:SS)
- title: short, attractive YouTube title (max 70 chars)
- description: 2-3 sentence YouTube description
- tags: list of 3-5 relevant tags

Rules:
- Each clip must be between $MIN_DURATION and $MAX_DURATION seconds
- Ignore opening/greeting segments and generic closings
- Focus on educational content, practical tips and demonstrations
- Titles should be attractive and use search keywords
- Clips must NOT overlap

Retorne APENAS um JSON válido com esta estrutura:
{
  \"video_title\": \"título original resumido\",
  \"topics\": [
    {
      \"start\": \"MM:SS\",
      \"end\": \"MM:SS\",
      \"title\": \"...\",
      \"description\": \"...\",
      \"tags\": [\"tag1\", \"tag2\", \"tag3\"]
    }
  ]
}

TRANSCRIÇÃO:"
fi

if [[ -f "$JOB_DIR/topics.json" ]]; then
  echo "    Analysis already exists, skipping"

elif [[ "$AI_MODE" == "claude-api" ]]; then
  # --- Mode: Claude Code CLI (uses OAuth authentication) ---
  echo "    Using Claude Code CLI..."

  # Build full prompt in file
  cat > "$JOB_DIR/prompt.txt" << PROMPTEOF
$PROMPT_TEMPLATE

$(cat "$JOB_DIR/condensed.txt")
PROMPTEOF

  # Call claude CLI and save response (unset CLAUDECODE to allow execution in subprocess)
  env -u CLAUDECODE claude -p "$(cat "$JOB_DIR/prompt.txt")" --output-format text > "$JOB_DIR/claude_response.txt" 2>/dev/null

  # Extrai JSON da resposta
  python3 << PYEOF
import json, re

with open('$JOB_DIR/claude_response.txt') as f:
    response_text = f.read()

json_match = re.search(r'\{[\s\S]*\}', response_text)
if json_match:
    topics_data = json.loads(json_match.group())
    with open('$JOB_DIR/topics.json', 'w') as f:
        json.dump(topics_data, f, ensure_ascii=False, indent=2)
    print(f"    Found {len(topics_data.get('topics',[]))} topics")
else:
    print("Error: Claude did not return valid JSON")
    print(response_text[:500])
    exit(1)
PYEOF

elif [[ "$AI_MODE" == "anthropic-api" ]]; then
  # --- Mode: Anthropic API Key (uses ANTHROPIC_API_KEY directly) ---
  echo "    Using Anthropic API..."

  if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    echo "Error: ANTHROPIC_API_KEY not defined" >&2
    exit 1
  fi

  # Build full prompt in file
  cat > "$JOB_DIR/prompt.txt" << PROMPTEOF
$PROMPT_TEMPLATE

$(cat "$JOB_DIR/condensed.txt")
PROMPTEOF

  # Chama Anthropic API via curl
  python3 << PYEOF
import json, urllib.request, os, re

api_key = os.environ['ANTHROPIC_API_KEY']

with open('$JOB_DIR/prompt.txt') as f:
    prompt_text = f.read()

payload = {
    'model': 'claude-sonnet-4-20250514',
    'max_tokens': 4096,
    'messages': [{'role': 'user', 'content': prompt_text}]
}

body = json.dumps(payload).encode()
req = urllib.request.Request('https://api.anthropic.com/v1/messages', data=body)
req.add_header('Content-Type', 'application/json')
req.add_header('x-api-key', api_key)
req.add_header('anthropic-version', '2023-06-01')

resp = urllib.request.urlopen(req, timeout=120)
result = json.loads(resp.read())
response_text = result['content'][0]['text']

json_match = re.search(r'\{[\s\S]*\}', response_text)
if json_match:
    topics_data = json.loads(json_match.group())
    with open('$JOB_DIR/topics.json', 'w') as f:
        json.dump(topics_data, f, ensure_ascii=False, indent=2)
    print(f"    Found {len(topics_data.get('topics',[]))} topics")
else:
    print("Error: Claude did not return valid JSON")
    print(response_text[:500])
    exit(1)
PYEOF

elif [[ "$AI_MODE" == "openrouter-api" ]]; then
  # --- Mode: OpenRouter API ---
  echo "    Using OpenRouter API..."

  if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
    echo "Error: OPENROUTER_API_KEY not defined" >&2
    exit 1
  fi

  cat > "$JOB_DIR/prompt.txt" << PROMPTEOF
$PROMPT_TEMPLATE

$(cat "$JOB_DIR/condensed.txt")
PROMPTEOF

  python3 << PYEOF
import json, urllib.request, os, re

api_key = os.environ['OPENROUTER_API_KEY']
model = os.environ.get('AI_MODEL', 'anthropic/claude-sonnet-4')

with open('$JOB_DIR/prompt.txt') as f:
    prompt_text = f.read()

payload = {
    'model': model,
    'messages': [{'role': 'user', 'content': prompt_text}],
    'max_tokens': 4096
}

body = json.dumps(payload).encode()
req = urllib.request.Request('https://openrouter.ai/api/v1/chat/completions', data=body)
req.add_header('Content-Type', 'application/json')
req.add_header('Authorization', f'Bearer {api_key}')

resp = urllib.request.urlopen(req, timeout=120)
result = json.loads(resp.read())
response_text = result['choices'][0]['message']['content']

json_match = re.search(r'\{[\s\S]*\}', response_text)
if json_match:
    topics_data = json.loads(json_match.group())
    with open('$JOB_DIR/topics.json', 'w') as f:
        json.dump(topics_data, f, ensure_ascii=False, indent=2)
    print(f"    Found {len(topics_data.get('topics',[]))} topics")
else:
    print("Error: did not return valid JSON")
    print(response_text[:500])
    exit(1)
PYEOF

elif [[ "$AI_MODE" == "piramyd-api" ]]; then
  # --- Mode: Piramyd API ---
  echo "    Using Piramyd API..."

  if [[ -z "${PIRAMYD_API_KEY:-}" ]]; then
    echo "Error: PIRAMYD_API_KEY not defined" >&2
    exit 1
  fi

  cat > "$JOB_DIR/prompt.txt" << PROMPTEOF
$PROMPT_TEMPLATE

$(cat "$JOB_DIR/condensed.txt")
PROMPTEOF

  python3 << PYEOF
import json, urllib.request, os, re

api_key = os.environ['PIRAMYD_API_KEY']
model = os.environ.get('AI_MODEL', 'claude-sonnet-4.5')

with open('$JOB_DIR/prompt.txt') as f:
    prompt_text = f.read()

payload = {
    'model': model,
    'messages': [{'role': 'user', 'content': prompt_text}],
    'max_tokens': 4096
}

body = json.dumps(payload).encode()
req = urllib.request.Request('https://api.piramyd.cloud/v1/chat/completions', data=body)
req.add_header('Content-Type', 'application/json')
req.add_header('Authorization', f'Bearer {api_key}')

resp = urllib.request.urlopen(req, timeout=120)
result = json.loads(resp.read())
response_text = result['choices'][0]['message']['content']

json_match = re.search(r'\{[\s\S]*\}', response_text)
if json_match:
    topics_data = json.loads(json_match.group())
    with open('$JOB_DIR/topics.json', 'w') as f:
        json.dump(topics_data, f, ensure_ascii=False, indent=2)
    print(f"    Found {len(topics_data.get('topics',[]))} topics")
else:
    print("Error: did not return valid JSON")
    print(response_text[:500])
    exit(1)
PYEOF

elif [[ "$AI_MODE" == "manual" ]]; then
  # --- Mode: Manual (generates prompt for interactive session) ---
  # Saves the full prompt to be used by Claude Code or pasted manually
  cat > "$JOB_DIR/prompt.txt" << PROMPTEOF
$PROMPT_TEMPLATE

$(cat "$JOB_DIR/condensed.txt")
PROMPTEOF

  echo ""
  echo "    Prompt saved at: $JOB_DIR/prompt.txt"
  echo ""
  echo "    To continue, create the topics.json file with the analysis."
  echo "    Options:"
  echo "      1. Paste the content of prompt.txt into Claude and save the response as topics.json"
  echo "      2. Use Claude Code: read prompt.txt, analyze and write topics.json"
  echo "      3. Run again with --ai claude-api (requires ANTHROPIC_API_KEY)"
  echo ""
  echo "    Then run again: yt-clip $VIDEO_ID"
  exit 0
fi

# Show topics
echo ""
python3 << PYEOF
import json
with open('$JOB_DIR/topics.json') as f:
    data = json.load(f)

print(f"    Video: {data.get('video_title','')}")
print(f"    Topics: {len(data.get('topics',[]))}")
print("")
for i, t in enumerate(data.get('topics', []), 1):
    print(f"    [{i}] {t['start']} → {t['end']}  {t['title']}")
    print(f"        {t['description'][:100]}...")
    print(f"        Tags: {', '.join(t.get('tags',[]))}")
    print("")
PYEOF

if [[ "$DRY_RUN" == "true" ]]; then
  echo "==> Dry run complete. Topics saved at: $JOB_DIR/topics.json"
  exit 0
fi

# ============================================================
# STEP 4: Download video and cut with FFmpeg
# ============================================================
echo "==> [4/5] Downloading video and cutting clips..."

# Validate existing source.mp4 (remove if corrupted/incomplete)
if [[ -f "$JOB_DIR/source.mp4" ]]; then
  if ! ffprobe -v error -select_streams v:0 -show_entries stream=codec_type "$JOB_DIR/source.mp4" >/dev/null 2>&1; then
    echo "    Existing source.mp4 is corrupted, removing for re-download..."
    rm -f "$JOB_DIR/source.mp4"
  fi
fi

# Download video if not exists
if [[ ! -f "$JOB_DIR/source.mp4" ]]; then
  echo "    Downloading video..."
  if ! yt-dlp --cookies-from-browser firefox --remote-components ejs:github \
    -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]" \
    --merge-output-format mp4 \
    -o "$JOB_DIR/source.mp4" \
    "https://www.youtube.com/watch?v=$VIDEO_ID" 2>/dev/null; then
    echo "    Failed with cookies, trying without cookies..."
    yt-dlp --remote-components ejs:github \
      -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]" \
      --merge-output-format mp4 \
      -o "$JOB_DIR/source.mp4" \
      "https://www.youtube.com/watch?v=$VIDEO_ID" 2>/dev/null
  fi
  echo "    Download complete"

  # Validate freshly downloaded file
  if ! ffprobe -v error -select_streams v:0 -show_entries stream=codec_type "$JOB_DIR/source.mp4" >/dev/null 2>&1; then
    echo "Error: downloaded source.mp4 is corrupted" >&2
    rm -f "$JOB_DIR/source.mp4"
    exit 1
  fi
fi

# Cut clips
python3 << PYEOF
import json, subprocess, os

with open('$JOB_DIR/topics.json') as f:
    data = json.load(f)

clips_dir = '$JOB_DIR/clips'
os.makedirs(clips_dir, exist_ok=True)

results = []
failed = 0

for i, t in enumerate(data.get('topics', []), 1):
    start = t['start']
    end = t['end']

    # Convert MM:SS to seconds
    sp = start.split(':')
    start_sec = int(sp[0]) * 60 + int(sp[1])
    ep = end.split(':')
    end_sec = int(ep[0]) * 60 + int(ep[1])
    duration = end_sec - start_sec

    safe_title = ''.join(c if c.isalnum() or c in ' -_' else '' for c in t['title'])[:50].strip()
    filename = f"clip_{i:02d}_{safe_title}.mp4"
    filepath = os.path.join(clips_dir, filename)

    if os.path.exists(filepath) and os.path.getsize(filepath) > 0:
        print(f"    Clip {i} already exists, skipping")
    else:
        print(f"    Cutting clip {i}: {start} → {end} ({duration}s) - {t['title'][:50]}")
        cmd = [
            'ffmpeg', '-y',
            '-ss', str(start_sec),
            '-i', '$JOB_DIR/source.mp4',
            '-t', str(duration),
            '-c', 'copy',
            '-avoid_negative_ts', 'make_zero',
            filepath
        ]
        r = subprocess.run(cmd, capture_output=True)
        if r.returncode != 0 or not os.path.exists(filepath) or os.path.getsize(filepath) == 0:
            err = r.stderr.decode('utf-8', errors='replace')[-300:] if r.stderr else ''
            print(f"    ERROR clip {i} (rc={r.returncode}): {err}")
            failed += 1
            try: os.remove(filepath)
            except OSError: pass
            continue

    results.append({
        'index': i,
        'file': filepath,
        'filename': filename,
        'title': t['title'],
        'description': t['description'],
        'tags': t.get('tags', []),
        'duration': duration
    })

with open('$JOB_DIR/clips_manifest.json', 'w') as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

total = len(data.get('topics', []))
print(f"\n    {len(results)} clips cut in: {clips_dir}")
if failed == total and total > 0:
    print(f"    ERROR: all {total} clips failed in ffmpeg")
    exit(1)
PYEOF

# ============================================================
# STEP 5: Publish to YouTube (if --publish)
# ============================================================
if [[ "$PUBLISH" == "true" ]]; then
  echo "==> [5/5] Publishing clips to YouTube..."

  python3 << PYEOF
import json, subprocess

with open('$JOB_DIR/clips_manifest.json') as f:
    clips = json.load(f)

published = []

for clip in clips:
    print(f"\n    Publishing: {clip['title']}")

    tags = ','.join(clip.get('tags', []))

    cmd = [
        'yt-publish', clip['file'],
        '--title', clip['title'],
        '--description', clip['description'],
        '--privacy', '$PRIVACY',
        '--tags', tags,
        '--category', '27'
    ]

    result = subprocess.run(cmd, capture_output=True, text=True)
    output = result.stdout + result.stderr

    # Extract video ID from output
    for line in output.split('\n'):
        if 'Video ID:' in line:
            vid = line.split('Video ID:')[1].strip()
            published.append({
                'title': clip['title'],
                'video_id': vid,
                'url': f'https://www.youtube.com/watch?v={vid}'
            })
            print(f"    ✓ Publicado: https://www.youtube.com/watch?v={vid}")
            break
    else:
        print(f"    ✗ Error: {output[:200]}")

with open('$JOB_DIR/published.json', 'w') as f:
    json.dump(published, f, ensure_ascii=False, indent=2)

print(f"\n==> {len(published)} clips published!")
PYEOF
else
  echo "==> [5/5] Publishing skipped (use --publish to publish)"
fi

echo ""
echo "==> Done! Files at: $JOB_DIR"
echo "    - topics.json: identified topics"
echo "    - clips/: cut videos"
if [[ "$PUBLISH" == "true" ]]; then
  echo "    - published.json: links to published videos"
fi
